PORT=5000
NODE_ENV=development
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Only needed if LLM_PROVIDER=openai ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Only needed if LLM_PROVIDER=ollama ---
# 1. Install Ollama from https://ollama.com
# 2. Run: ollama pull llama3   (or another model, e.g. mistral, phi3)
# 3. Ollama serves automatically on http://localhost:11434 - no API key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Optional: only needed if you want MongoDB persistence (SQLite is used by default) ---
MONGODB_URI=your_mongodb_connection_string_here
